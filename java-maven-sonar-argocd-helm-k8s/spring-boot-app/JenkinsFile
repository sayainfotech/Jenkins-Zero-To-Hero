
pipeline {
    agent {
        docker {
            image 'abhishekf5/maven-abhishek-docker-agent:v1'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    stages {
        stage('Checkout') {
            steps {
                sh 'echo passed'
            }
        }

        stage('Build and Test') {
            steps {
                sh 'ls -ltr'
                sh '''
                    cd java-maven-sonar-argocd-helm-k8s/spring-boot-app
                    mvn clean package
                '''
            }
        }

        stage('Static Code Analysis') {
            environment {
                SONAR_URL = 'http://54.206.34.54:9000/'
            }
            steps {
                withCredentials([
                    string(
                        credentialsId: 'sonarqube',
                        variable: 'SONAR_AUTH_TOKEN'
                    )
                ]) {
                    sh '''
                        cd java-maven-sonar-argocd-helm-k8s/spring-boot-app

                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                          -Dsonar.login="$SONAR_AUTH_TOKEN" \
                          -Dsonar.host.url="$SONAR_URL"
                    '''
                }
            }
        }

        stage('Fix Docker CLI') {
            steps {
                sh '''
                    set -eu

                    echo "Current Docker CLI:"
                    docker version || true

                    # This download step assumes a Debian/Ubuntu-based
                    # agent with apt-get and a supported CPU architecture.
                    apt-get update
                    apt-get install -y --no-install-recommends \
                        curl ca-certificates tar

                    ARCH="$(uname -m)"
                    case "$ARCH" in
                        x86_64)  DOCKER_ARCH="x86_64" ;;
                        aarch64) DOCKER_ARCH="aarch64" ;;
                        *)
                            echo "Unsupported architecture: $ARCH"
                            exit 1
                            ;;
                    esac

                    DOCKER_CLI_VERSION="27.5.1"
                    curl -fsSL \
                      "https://download.docker.com/linux/static/stable/${DOCKER_ARCH}/docker-${DOCKER_CLI_VERSION}.tgz" \
                      -o /tmp/docker-cli.tgz

                    mkdir -p /tmp/docker-cli
                    tar -xzf /tmp/docker-cli.tgz -C /tmp/docker-cli

                    install -m 0755 \
                      /tmp/docker-cli/docker/docker \
                      /usr/local/bin/docker

                    unset DOCKER_API_VERSION || true

                    echo "Updated Docker CLI:"
                    /usr/local/bin/docker version
                '''
            }
        }

        stage('Build and Push Docker Image') {
            environment {
                DOCKER_IMAGE = "abhisheksaya5/first-cicd:${BUILD_NUMBER}"
            }
            steps {
                script {
                    sh '''
                        set -eu
                        unset DOCKER_API_VERSION || true

                        cd java-maven-sonar-argocd-helm-k8s/spring-boot-app

                        /usr/local/bin/docker build \
                          -t "$DOCKER_IMAGE" .
                    '''

                    def dockerImage = docker.image("${DOCKER_IMAGE}")

                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'docker-cred'
                    ) {
                        dockerImage.push()
                    }
                }
            }
        }

        stage('Update Deployment File') {
            environment {
                GIT_REPO_NAME = 'Jenkins-Zero-To-Hero'
                GIT_USER_NAME = 'sayainfotech'
            }
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        git config user.email "abhisheksaya98@gmail.com"
                        git config user.name "sayainfotech"

                        sed -i \
                          "s/replaceImageTag/${BUILD_NUMBER}/g" \
                          java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml

                        git add \
                          java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml

                        git commit -m \
                          "Update deployment image to version ${BUILD_NUMBER}"

                        git push \
                          "https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git" \
                          HEAD:main
                    '''
                }
            }
        }
    }
}
